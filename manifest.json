{
  "manifest_version": 3,
  "name": "Glimmer Fic Spotify Integration",
  "version": "1.0.0",
  "description": "Chrome extension to automatically play Spotify songs on Glimmer Fic",
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://api.spotify.com/*",
    "https://accounts.spotify.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.glimmerfic.com/*"],
      "js": ["content.js"]
    }
  ]
}
